{
  "name": "memos-cloud-host-plugins",
  "private": true,
  "version": "0.1.0",
  "description": "MemOS Cloud host integrations monorepo",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "prepare:openclaw": "node scripts/prepare-package.mjs openclaw",
    "pack:dsh": "node scripts/pack-package.mjs dsh",
    "publish:openclaw:dry-run": "node scripts/release-package.mjs openclaw --channel stable --bump current --dry-run",
    "publish:openclaw": "node scripts/release-package.mjs openclaw --channel stable --bump current",
    "publish:openclaw:patch:dry-run": "node scripts/release-package.mjs openclaw --channel stable --bump patch --dry-run",
    "publish:openclaw:patch": "node scripts/release-package.mjs openclaw --channel stable --bump patch",
    "publish:openclaw:beta": "node scripts/release-package.mjs openclaw --channel beta --bump current",
    "publish:openclaw:beta-patch": "node scripts/release-package.mjs openclaw --channel beta --bump patch",
    "publish:dsh:dry-run": "node scripts/release-package.mjs dsh --channel stable --bump current --dry-run",
    "publish:dsh": "node scripts/release-package.mjs dsh --channel stable --bump current",
    "publish:dsh:patch:dry-run": "node scripts/release-package.mjs dsh --channel stable --bump patch --dry-run",
    "publish:dsh:patch": "node scripts/release-package.mjs dsh --channel stable --bump patch",
    "publish:dsh:beta": "node scripts/release-package.mjs dsh --channel beta --bump current",
    "publish:dsh:beta-patch": "node scripts/release-package.mjs dsh --channel beta --bump patch"
  },
  "devDependencies": {
    "semver": "^7.8.5"
  }
}
