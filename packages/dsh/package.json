{
  "name": "@memtensor/memos-cloud-dsh-plugin",
  "description": "MemOS Cloud lifecycle memory plugin for DeepSeek Harness",
  "version": "0.1.2",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/index.d.ts",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "pnpm --filter @memtensor/memos-cloud-plugin-core build && tsdown --config tsdown.config.ts",
    "test": "pnpm --filter @memtensor/memos-cloud-plugin-core build && vitest run --config vitest.config.ts",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "prepack": "pnpm build",
    "test:types": "node scripts/check-sdk.mjs",
    "test:host": "node scripts/host-smoke.mjs",
    "test:standalone": "node scripts/standalone-smoke.mjs"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.1.0-rc.6 <0.3.0-0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "memos",
    "memory",
    "deepseek-harness",
    "dsh-plugin"
  ],
  "homepage": "https://github.com/MemTensor/MemOS-Cloud-OpenClaw-Plugin/tree/main/packages/dsh#readme",
  "bugs": {
    "url": "https://github.com/MemTensor/MemOS-Cloud-OpenClaw-Plugin/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MemTensor/MemOS-Cloud-OpenClaw-Plugin.git",
    "directory": "packages/dsh"
  },
  "author": "MemTensor",
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.6 || ^0.1.2-rc.1 || ^0.1.7-0 || ^0.2.0-0 || ^0.2.1-0",
    "@deepseek-ai/dsh-credentials": "^0.1.0-rc.6 || ^0.1.2-rc.1 || ^0.1.7-0 || ^0.2.0-0 || ^0.2.1-0",
    "@deepseek-ai/dsh-launch-environment": "^0.1.0-rc.6 || ^0.1.2-rc.1 || ^0.1.7-0 || ^0.2.0-0 || ^0.2.1-0",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6 || ^0.1.2-rc.1 || ^0.1.7-0 || ^0.2.0-0 || ^0.2.1-0",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.6 || ^0.1.2-rc.1 || ^0.1.7-0 || ^0.2.0-0 || ^0.2.1-0",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.6 || ^0.1.2-rc.1 || ^0.1.7-0 || ^0.2.0-0 || ^0.2.1-0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/cordis-plugin-include": "1.0.10",
    "@deepseek-ai/cordis-plugin-loader": "1.0.6",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-credentials": "0.2.1-rc.2",
    "@deepseek-ai/dsh-launch-environment": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-scope": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-settings": "0.2.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.2",
    "@memtensor/memos-cloud-plugin-core": "workspace:*",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.0",
    "js-yaml": "^4.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-credentials": {
      "optional": true
    },
    "@deepseek-ai/dsh-launch-environment": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-settings": {
      "optional": true
    }
  }
}
